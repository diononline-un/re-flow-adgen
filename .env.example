# Re-Flow-AdGen — lokale Entwicklung
# Kopieren nach .env.local (gitignored) und Werte setzen.

# --- PocketBase ---
# Admin-Superuser (nur beim Seed verwendet)
ADMIN_EMAIL=diononline@adgen.local
# Initialpasswort, nur einmal ausgegeben. Nach Erstlogin im Admin-UI ändern.
ADMIN_INITIAL_PASSWORD=change-me

# --- API-Service ---
PB_URL=http://pocketbase:8080
# AES-256-GCM-Key (64 Hex-Zeichen = 32 Byte). Erzeugen: openssl rand -hex 32
ENCRYPTION_KEY=
# Stub-Modus: Provider-Antworten sind vorgetäuscht (kein echter API-Call, keine Kosten)
PROVIDER_STUB=true
# Ports nur für lokale Host-Bindungen
API_PORT=8787
